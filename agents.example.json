{
  "campaign_context": [],
  "llm": {
    "endpoint": "http://127.0.0.1:8000/v1/chat/completions",
    "model": "local-model"
  },
  "agents": [
    { "id": "recorder", "kind": "recorder", "enabled": true, "output": "transcript.jsonl", "run_every_segments": 1 },
    { "id": "summary", "kind": "live_summary", "enabled": true, "output": "summary.md", "instruction": "Keep unresolved player questions visible.", "run_every_segments": 1 },
    { "id": "gm-next-steps", "kind": "next_steps", "enabled": true, "output": "gm-next-steps.md", "instruction": "Offer choices without prescribing a single action.", "run_every_segments": 3 },
    { "id": "model-copilot", "kind": "llm", "enabled": false, "output": "model-copilot.md", "prompt_file": "prompts/gm-copilot.md", "include_campaign_context": false, "workspace_query": "campaign canon open threads NPC lore locations quests", "workspace_paths": [], "run_every_segments": 6 },
    { "id": "continuity-watcher", "kind": "llm", "enabled": false, "output": "continuity-watcher.md", "prompt_file": "prompts/continuity-watcher.md", "include_campaign_context": false, "workspace_query": "canon history NPC locations factions quests lore", "workspace_paths": [], "run_every_segments": 8 },
    { "id": "player-interest", "kind": "llm", "enabled": false, "output": "player-interest.md", "prompt_file": "prompts/player-interest.md", "include_campaign_context": false, "workspace_query": "characters NPC locations quests open threads lore", "workspace_paths": [], "run_every_segments": 8 },
    { "id": "session-scribe", "kind": "llm", "enabled": false, "output": "session-scribe.md", "prompt_file": "prompts/session-scribe.md", "include_campaign_context": false, "workspace_query": "sessions canon NPC locations quests open threads", "workspace_paths": [], "run_every_segments": 12 },
    { "id": "session-supervisor", "kind": "session_editor", "enabled": false, "output": "campaign-update-summary.md", "prompt_file": "prompts/session-supervisor.md", "workspace_paths": [], "write_paths": [] }
  ]
}
